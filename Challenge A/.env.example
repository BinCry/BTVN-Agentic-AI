# Optional: copy to .env only when running `ask --provider gemini`.
# Create a key at https://aistudio.google.com/app/apikey. Never commit the real key.
GEMINI_API_KEY=your_google_ai_studio_key_here
# Override only if your Gemini API key has access to a different model.
GEMINI_MODEL=gemini-3.5-flash-lite
